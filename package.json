{
  "name": "market-regime-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Market Regime State Platform - 거시 시장 상태 요약 웹서비스",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm -C packages/database prisma generate",
    "db:migrate": "pnpm -C packages/database prisma migrate dev",
    "db:studio": "pnpm -C packages/database prisma studio",
    "db:push": "pnpm -C packages/database prisma db push"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
