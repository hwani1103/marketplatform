// Prisma Schema for Market Regime Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// V2: User Management
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  comments  Comment[]

  @@map("users")
}

// Raw Indicator Data (from external APIs)
model IndicatorRaw {
  id        String   @id @default(cuid())
  symbol    String   // S&P500, VIX, 10Y, DXY, etc.
  value     Float
  timestamp DateTime
  source    String   // FRED, Yahoo Finance
  metadata  Json?    // Additional metadata
  createdAt DateTime @default(now()) @map("created_at")

  @@index([symbol, timestamp])
  @@map("indicators_raw")
}

// Layer 1: Processed Indicators (Normalized)
model IndicatorProcessed {
  id           String   @id @default(cuid())
  symbol       String
  value        Float

  // Moving Averages
  ma20         Float?
  ma60         Float?
  maDeviation  Float?   @map("ma_deviation") // % deviation from MA

  // Z-score
  zScore       Float?   @map("z_score")

  // Layer 1 outputs
  trendShort   String?  @map("trend_short")  // UP, DOWN, FLAT
  positionMid  String?  @map("position_mid")  // ABOVE_MA, BELOW_MA

  timestamp    DateTime
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@index([symbol, timestamp])
  @@map("indicators_processed")
}

// Layer 2-4: Market State
model LayerState {
  id              String   @id @default(cuid())
  timestamp       DateTime @unique

  // Layer 2: Risk Environment
  riskState       String   @map("risk_state") // RISK_ON, NEUTRAL, RISK_OFF
  riskScore       Float?   @map("risk_score")

  // Layer 3: Liquidity Environment
  liquidityState  String   @map("liquidity_state") // EASING, NEUTRAL, TIGHTENING
  liquidityScore  Float?   @map("liquidity_score")

  // Layer 4: Structure & Stability
  structureState  String   @map("structure_state") // ALIGNED, CONFLICT
  stabilityLevel  String   @map("stability_level") // HIGH, MEDIUM, LOW

  // Supporting data
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([timestamp])
  @@map("layer_states")
}

// Final Market Regime
model MarketRegime {
  id              String    @id @default(cuid())

  // Regime enum
  regime          String    // STABLE_RISK_ON, SUPPORTIVE, etc.

  // Human-readable description (from LLM)
  description     String
  descriptionEn   String?   @map("description_en")

  // States
  riskState       String    @map("risk_state")
  liquidityState  String    @map("liquidity_state")
  stabilityLevel  String    @map("stability_level")

  // Duration tracking
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  durationDays    Int       @default(0) @map("duration_days")

  // Metadata
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([startDate])
  @@index([regime])
  @@map("market_regimes")
}

// V2: Comments on regimes or indicators
model Comment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type") // 'regime' or 'indicator'
  targetId   String   @map("target_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@map("comments")
}
